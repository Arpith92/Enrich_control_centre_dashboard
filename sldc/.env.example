SLDC_URL=https://mahasldc.in/scada/reports/mvrreport8
REFRESH_SECONDS=5
SAMPLE_MINUTES=15
API_HOST=0.0.0.0
API_PORT=5173
SQL_CONNECTION_STRING=
MONGODB_URI=
# Read-only URI for real-time site SCADA (kept separate from SLDC sample storage).
SCADA_MONGODB_URI=
SCADA_MONGODB_DATABASE=
# JSON mapping of dashboard site names to one or more Mongo collection names.
SCADA_SITE_COLLECTIONS={"Bhokar":["B1_Jugai","B2_Jagdeesh","B4_Padmavati","B7_Suyash","B5_SoundCasting","B3_Supriya","B6_IMP","B8_Veersha","B9_Omya"]}
# ActivePower and Cumulative_Generation are assumed to be kW and kWh.
SCADA_POWER_TO_MW=0.001
SCADA_GENERATION_TO_MWH=0.001
SCADA_MAX_AGE_SECONDS=300
SCADA_REFRESH_SECONDS=60
ALLOW_SQLITE_FALLBACK=true
TESSERACT_CMD=/usr/bin/tesseract
